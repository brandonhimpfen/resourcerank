{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resourcerank.dev/schema/evaluation.schema.json",
  "title": "ResourceRank Evaluation Case",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "resource",
    "submission",
    "assessment",
    "decision",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "submission": {
      "type": "object",
      "required": [
        "awesome_list",
        "category",
        "contributor",
        "affiliation_disclosed",
        "affiliated_submission",
        "cross_list_submission"
      ],
      "properties": {
        "awesome_list": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "contributor": {
          "type": "string"
        },
        "affiliation_disclosed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "affiliated_submission": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cross_list_submission": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "assessment": {
      "type": "object",
      "required": [
        "category_fit",
        "primary_concerns"
      ],
      "properties": {
        "category_fit": {
          "enum": [
            "low",
            "partial",
            "high"
          ]
        },
        "primary_concerns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "accept",
            "reject",
            "review"
          ]
        },
        "recommended_section": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "reviewed_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
